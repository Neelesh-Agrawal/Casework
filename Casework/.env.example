# Local development only — copy to .env and fill in values.
# NEVER commit .env to git.

# ── AI features (optional) ───────────────────────────────────────────────────
# Groq is recommended (free tier): https://console.groq.com
# VITE_GROQ_API_KEY=gsk_...
# VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Or Anthropic:
# VITE_ANTHROPIC_API_KEY=sk-ant-...
# VITE_ANTHROPIC_MODEL=claude-haiku-4-5

# ── Public deployment (IMPORTANT) ────────────────────────────────────────────
# When you share the site publicly, set this to false so visitors don't burn
# your API quota. The full game works without AI — only mentor/case-study extras are off.
VITE_ENABLE_LLM=false

# ── Chapter feedback → Google Sheets (recommended on Vercel) ─────────────────
# Browser posts to /api/feedback (Vercel serverless proxy, no CORS issues).
# The proxy forwards to your Google Apps Script web app URL.
#
# Vercel env (Production):
#   GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
#   FEEDBACK_WEBHOOK_SECRET=your-random-secret   (optional but recommended)
#
# Setup script: scripts/google-sheets-apps-script.gs
#
# Optional override if you use a different collector URL:
# VITE_FEEDBACK_ENDPOINT=/api/feedback
